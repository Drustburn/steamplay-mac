 enum ntdll_unix_funcs
 {
     unix_load_so_dll,
@@ -82,6 +88,7 @@ enum ntdll_unix_funcs
     unix_wine_server_handle_to_fd,
     unix_wine_spawnvp,
     unix_system_time_precise,
+    unix_steamclient_setup_trampolines,
