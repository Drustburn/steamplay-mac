From b4aa38c8ac04b483a413360633968cf52e0f4b5b Mon Sep 17 00:00:00 2001
From: Daniel Risto <danielristo98@gmail.com>
Date: Thu, 8 Oct 2026 11:53:59 +0200
Subject: [PATCH 2/2] build: register dlls/lsteamclient; let makedep see
 #pragma makedep unix in .cpp

---
 configure       | 2 ++
 configure.ac    | 1 +
 tools/makedep.c | 1 +
 3 files changed, 4 insertions(+)

diff --git a/configure b/configure
index 26e224a..6c631a8 100755
--- a/configure
+++ b/configure
@@ -1225,6 +1225,7 @@ enable_light_msstyles
 enable_loadperf
 enable_localspl
 enable_localui
+enable_lsteamclient
 enable_lz32
 enable_magnification
 enable_mapi32
@@ -22864,6 +22865,7 @@ wine_fn_config_makefile dlls/localspl enable_localspl
 wine_fn_config_makefile dlls/localspl/tests enable_tests
 wine_fn_config_makefile dlls/localui enable_localui
 wine_fn_config_makefile dlls/localui/tests enable_tests
+wine_fn_config_makefile dlls/lsteamclient enable_lsteamclient
 wine_fn_config_makefile dlls/lz32 enable_lz32
 wine_fn_config_makefile dlls/lz32/tests enable_tests
 wine_fn_config_makefile dlls/lzexpand.dll16 enable_win16
diff --git a/configure.ac b/configure.ac
index bf8e3c0..02ac81c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2861,6 +2861,7 @@ WINE_CONFIG_MAKEFILE(dlls/localspl)
 WINE_CONFIG_MAKEFILE(dlls/localspl/tests)
 WINE_CONFIG_MAKEFILE(dlls/localui)
 WINE_CONFIG_MAKEFILE(dlls/localui/tests)
+WINE_CONFIG_MAKEFILE(dlls/lsteamclient)
 WINE_CONFIG_MAKEFILE(dlls/lz32)
 WINE_CONFIG_MAKEFILE(dlls/lz32/tests)
 WINE_CONFIG_MAKEFILE(dlls/lzexpand.dll16)
diff --git a/tools/makedep.c b/tools/makedep.c
index 3a66bd6..31ebdfe 100644
--- a/tools/makedep.c
+++ b/tools/makedep.c
@@ -1237,6 +1237,7 @@ static const struct
 } parse_functions[] =
 {
     { ".c",   parse_c_file },
+    { ".cpp", parse_c_file },
     { ".h",   parse_c_file },
     { ".inl", parse_c_file },
     { ".l",   parse_c_file },
